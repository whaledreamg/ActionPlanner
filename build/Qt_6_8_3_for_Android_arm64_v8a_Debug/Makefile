####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/libs/arm64-v8a/ || mkdir -p $(INSTALL_ROOT)/libs/arm64-v8a/
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/libs/arm64-v8a/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/libs/arm64-v8a/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/libs/arm64-v8a/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

