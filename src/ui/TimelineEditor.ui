  <property name="styleSheet">
   <string notr="true">
QWidget#TimelineEditor {
    background-color: #0F131C;
    border-top: 1px solid #1E2636;
}
/* 工具栏按钮样式 */
QPushButton {
    background-color: #1E2636;
    border: 1px solid #2A3444;
    border-radius: 6px;
    padding: 8px 16px;
    color: #E8E9ED;
    font-size: 10pt;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #242D3D;
    border: 1px solid #38BDF8;
}
QPushButton:pressed {
    background-color: #2A3444;
}
QPushButton:disabled {
    background-color: #161D2B;
    color: #8A94A6;
    border: 1px solid #1E2636;
}
/* 主要操作按钮 */
QPushButton#btnPlay {
    background-color: #6EE7B7;
    border: none;
    color: #0A0D12;
    font-weight: 600;
    padding: 10px 24px;
}
QPushButton#btnPlay:hover {
    background-color: #7FEFC5;
}
QPushButton#btnAddSegment {
    background-color: #38BDF8;
    border: none;
    color: #0A0D12;
    font-weight: 600;
}
QPushButton#btnAddSegment:hover {
    background-color: #4AC5FF;
}
QPushButton#btnDeleteSegment {
    background-color: #E94560;
    border: none;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton#btnDeleteSegment:hover {
    background-color: #F05575;
}
/* 标签样式 */
QLabel {
    color: #C8D2E0;
    font-size: 10pt;
}
/* 循环勾选 */
QCheckBox {
    color: #C8D2E0;
    font-size: 10pt;
    spacing: 6px;
}
QCheckBox:hover {
    color: #38BDF8;
}
QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #2A3444;
    border-radius: 4px;
    background-color: #161D2B;
}
QCheckBox::indicator:hover {
    border: 1px solid #38BDF8;
}
QCheckBox::indicator:checked {
    background-color: #38BDF8;
    border: 1px solid #38BDF8;
}
   </string>
