  <property name="styleSheet">
   <string notr="true">
/* 主面板样式 */
QWidget#RobotControlPanel {
    background-color: #0F131C;
    border-radius: 8px;
}

/* 切换按钮 - 未选中状态（失能） */
QPushButton#btnToggleLeft,
QPushButton#btnToggleRight {
    background-color: #1E2636;
    border: 2px solid #38BDF8;
    color: #38BDF8;
    border-radius: 5px;
    padding: 4px 12px;
    font-weight: 600;
    font-size: 9pt;
    min-height: 22px;
    min-width: 84px;
}

QPushButton#btnToggleLeft:hover,
QPushButton#btnToggleRight:hover {
    background-color: #263445;
    border-color: #4AC5FF;
    color: #4AC5FF;
}

QPushButton#btnToggleLeft:pressed,
QPushButton#btnToggleRight:pressed {
    background-color: #2A3A50;
}

/* 切换按钮 - 选中状态（使能） */
QPushButton#btnToggleLeft:checked,
QPushButton#btnToggleRight:checked {
    background-color: #6EE7B7;
    border-color: #6EE7B7;
    color: #0A0D12;
}

QPushButton#btnToggleLeft:checked:hover,
QPushButton#btnToggleRight:checked:hover {
    background-color: #7EEFC3;
    border-color: #7EEFC3;
}

/* 切换按钮 - 禁用状态 */
QPushButton#btnToggleLeft:disabled,
QPushButton#btnToggleRight:disabled {
    background-color: #161D2B;
    border-color: #2A3444;
    color: #8A94A6;
}

/* 分组框样式 */
QGroupBox {
    background-color: #161D2B;
    border: 1px solid #1E2636;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 8px 8px 8px;
    font-weight: bold;
    color: #E8E9ED;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #38BDF8;
}

/* 标签样式 */
QLabel {
    color: #C8D2E0;
    font-size: 9pt;
}

/* 输入框样式 */
QLineEdit {
    background-color: #1E2636;
    border: 1px solid #2A3444;
    border-radius: 6px;
    padding: 8px 12px;
    color: #E8E9ED;
    font-size: 10pt;
}

QLineEdit:focus {
    border: 1px solid #38BDF8;
    background-color: #242D3D;
}

QSpinBox {
    background-color: #1E2636;
    border: 1px solid #2A3444;
    border-radius: 6px;
    padding: 6px 8px;
    color: #E8E9ED;
}

/* 下拉框（灵巧手预设手势等）：与输入框同色 */
QComboBox {
    background-color: #1E2636;
    border: 1px solid #2A3444;
    border-radius: 6px;
    padding: 6px 10px;
    color: #E8E9ED;
    font-size: 10pt;
    min-height: 20px;
}

QComboBox:hover, QComboBox:focus {
    border: 1px solid #38BDF8;
    background-color: #242D3D;
}

QComboBox:disabled {
    background-color: #161D2B;
    color: #8A94A6;
    border: 1px solid #1E2636;
}

/* 展开的条目列表是独立顶层窗口，不继承上面的 QComboBox 规则，
   必须单独指定背景/文字/选中态，否则条目文字会回退成系统深色，
   压在深色底上几乎看不见 */
QComboBox QAbstractItemView {
    background-color: #1E2636;
    border: 1px solid #2A3444;
    border-radius: 6px;
    padding: 4px;
    color: #E8E9ED;
    outline: none;
    selection-background-color: #38BDF8;
    selection-color: #0A0D12;
}

QComboBox QAbstractItemView::item {
    color: #E8E9ED;
    background-color: transparent;
    min-height: 26px;
    padding: 2px 6px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #38BDF8;
    color: #0A0D12;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2A3444;
    color: #E8E9ED;
}

/* 按钮样式 */
QPushButton {
    background-color: #1E2636;
    border: 1px solid #2A3444;
    border-radius: 6px;
    padding: 8px 16px;
    color: #E8E9ED;
    font-size: 10pt;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #242D3D;
    border: 1px solid #38BDF8;
}

QPushButton:pressed {
    background-color: #2A3444;
}

QPushButton:disabled {
    background-color: #161D2B;
    color: #8A94A6;
    border: 1px solid #1E2636;
}

/* 主要动作按钮 */
QPushButton#btnConnect,
QPushButton#btnEnableLeft,
QPushButton#btnEnableRight {
    background-color: #38BDF8;
    border: none;
    color: #0A0D12;
    font-weight: 600;
}

QPushButton#btnConnect:hover,
QPushButton#btnEnableLeft:hover,
QPushButton#btnEnableRight:hover {
    background-color: #4AC5FF;
}

QPushButton#btnConnect:pressed,
QPushButton#btnEnableLeft:pressed,
QPushButton#btnEnableRight:pressed {
    background-color: #2AA9DD;
}

/* 危险动作按钮 */
QPushButton#btnDisableLeft,
QPushButton#btnDisableRight {
    background-color: #E94560;
    border: none;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#btnDisableLeft:hover,
QPushButton#btnDisableRight:hover {
    background-color: #F05575;
}

/* Tab标签页样式 */
QTabWidget::pane {
    background-color: #161D2B;
    border: 1px solid #1E2636;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #1E2636;
    border: 1px solid #2A3444;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 20px;
    margin-right: 4px;
    color: #C8D2E0;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #161D2B;
    color: #38BDF8;
    border-color: #38BDF8;
    border-bottom: 1px solid #161D2B;
}

QTabBar::tab:hover:!selected {
    background-color: #242D3D;
    color: #E8E9ED;
}

/* 滚动区域样式 */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea &gt; QWidget &gt; QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: #1E2636;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #38BDF8;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
   </string>
